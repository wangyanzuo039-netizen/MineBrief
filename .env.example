# Template demo does not require a model key.
# Optional model-driven summary (keys stay in .env, never in Git):
MINING_LLM_KEY_ENV=MINING_LLM_API_KEY
MINING_LLM_API_KEY=
MINING_LLM_BASE_URL=https://api.deepseek.com
MINING_LLM_MODEL=deepseek-flash

# For live LME quotes, provide a legally obtained LME LH workbook with M01..M15:
# MINING_PRICE_FILE=/absolute/path/to/lh-closing-prices.xlsx
# MINING_PRICE_CONTRACT=2026-10
# MINING_PRICE_SOURCE_URL=https://www.lme.com/market-data/reports-and-data/historical-data-for-cash-settled-futures
